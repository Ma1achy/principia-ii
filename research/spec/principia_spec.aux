\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Adaptive substepping near a close encounter. Top: the minimum pairwise separation $r_{\qopname  \relax m{min}}(t)$ dips sharply during a close approach. Bottom: the substep count $N_{\text  {sub}}$ ramps up in response, capped at $N_{\qopname  \relax m{max}}$. Away from encounters, $N_{\text  {sub}}=1$ and the integrator runs at full macro-step size.}}{43}{figure.0.15}\protected@file@percent }
\newlabel{fig:adaptive_substepping}{{15}{43}{Adaptive substepping near a close encounter. Top: the minimum pairwise separation $r_{\min }(t)$ dips sharply during a close approach. Bottom: the substep count $N_{\text {sub}}$ ramps up in response, capped at $N_{\max }$. Away from encounters, $N_{\text {sub}}=1$ and the integrator runs at full macro-step size}{figure.0.15}{}}
