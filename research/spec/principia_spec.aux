\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Frequency diffusion two-window scheme. The unwrapped phase $\tilde  \theta (t)$ is fit by least-squares linear regression in two consecutive windows $W_1$ and $W_2$, yielding frequency estimates $\omega _1$ and $\omega _2$. The diffusion $D=|\omega _2-\omega _1|$ measures how much the dominant frequency changed between windows---large $D$ indicates chaotic or transient dynamics.}}{49}{figure.0.18}\protected@file@percent }
\newlabel{fig:freq_diffusion}{{18}{49}{Frequency diffusion two-window scheme. The unwrapped phase $\tilde \theta (t)$ is fit by least-squares linear regression in two consecutive windows $W_1$ and $W_2$, yielding frequency estimates $\omega _1$ and $\omega _2$. The diffusion $D=|\omega _2-\omega _1|$ measures how much the dominant frequency changed between windows---large $D$ indicates chaotic or transient dynamics}{figure.0.18}{}}
