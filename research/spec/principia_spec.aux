\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Tilt: rotating the 2D viewing plane through new dimensions. The lock point $\mathbf  z_0$ (red) stays fixed while the tilt parameter $\tau $ continuously rotates the basis vector $\mathbf  q_2$ out of its original direction ($z_4$) and into a new dimension ($z_5$). At $\tau =0$ the slice shows the base view; increasing $\tau $ reveals cross-sections through previously hidden dimensions. This is the central tool for testing the persistence hypothesis (\S  \ref  {sec:hypothesis}).}}{39}{figure.0.13}\protected@file@percent }
\newlabel{fig:slice_tilt}{{13}{39}{Tilt: rotating the 2D viewing plane through new dimensions. The lock point $\mathbf z_0$ (red) stays fixed while the tilt parameter $\tau $ continuously rotates the basis vector $\mathbf q_2$ out of its original direction ($z_4$) and into a new dimension ($z_5$). At $\tau =0$ the slice shows the base view; increasing $\tau $ reveals cross-sections through previously hidden dimensions. This is the central tool for testing the persistence hypothesis (\S \ref {sec:hypothesis})}{figure.0.13}{}}
