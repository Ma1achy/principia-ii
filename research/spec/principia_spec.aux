\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces Linearised decoder for deep zoom. Left: usable within-tile precision (in bits) versus quadtree depth. The full nonlinear decoder (red) loses precision as depth increases, hitting the \texttt  {f32} floor around depth 23. The linearised decoder (green) maintains full \texttt  {f32} precision at any depth because the reference IC $x_0$ is computed in \texttt  {f64} on the CPU and the per-sample correction $J_D\cdot \delta $ is small. Right: the computation split between CPU (\texttt  {f64}) and GPU (\texttt  {f32}).}}{102}{figure.0.30}\protected@file@percent }
\newlabel{fig:linearised_decoder}{{30}{102}{Linearised decoder for deep zoom. Left: usable within-tile precision (in bits) versus quadtree depth. The full nonlinear decoder (red) loses precision as depth increases, hitting the \texttt {f32} floor around depth 23. The linearised decoder (green) maintains full \texttt {f32} precision at any depth because the reference IC $x_0$ is computed in \texttt {f64} on the CPU and the per-sample correction $J_D\cdot \delta $ is small. Right: the computation split between CPU (\texttt {f64}) and GPU (\texttt {f32})}{figure.0.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces \texttt  {SimResult} memory layout (208 bytes at $M=8$). Top: field blocks to scale. The checkpoint array dominates. New invariant monitoring fields (purple) add 20 bytes. Bottom: bit-packing layouts for \texttt  {sample\_descriptor} (32 bits) and \texttt  {trajectory\_stats} (32 bits).}}{103}{figure.0.31}\protected@file@percent }
\newlabel{fig:simresult_layout}{{31}{103}{\texttt {SimResult} memory layout (208 bytes at $M=8$). Top: field blocks to scale. The checkpoint array dominates. New invariant monitoring fields (purple) add 20 bytes. Bottom: bit-packing layouts for \texttt {sample\_descriptor} (32 bits) and \texttt {trajectory\_stats} (32 bits)}{figure.0.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {32}{\ignorespaces Split/keep/merge decision logic as a flowchart. Guard conditions (AT\_F32\_FLOOR, MAX\_DEPTH, off-screen) are checked first. Then force-split conditions (impurity, suspect fraction). Then the composite score threshold. Finally, overresolved tiles are merged. The default is keep.}}{104}{figure.0.32}\protected@file@percent }
\newlabel{fig:split_flowchart}{{32}{104}{Split/keep/merge decision logic as a flowchart. Guard conditions (AT\_F32\_FLOOR, MAX\_DEPTH, off-screen) are checked first. Then force-split conditions (impurity, suspect fraction). Then the composite score threshold. Finally, overresolved tiles are merged. The default is keep}{figure.0.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces Tile lifecycle state machine. Transitions are labelled by their triggers. The \texttt  {ReadyRefinable} state distinguishes ``done enough to display'' from ``done forever''---the scheduler can revisit refinable tiles if budget allows. Eviction is weighted by recomputation cost (expensive tiles resist eviction).}}{105}{figure.0.33}\protected@file@percent }
\newlabel{fig:tile_lifecycle}{{33}{105}{Tile lifecycle state machine. Transitions are labelled by their triggers. The \texttt {ReadyRefinable} state distinguishes ``done enough to display'' from ``done forever''---the scheduler can revisit refinable tiles if budget allows. Eviction is weighted by recomputation cost (expensive tiles resist eviction)}{figure.0.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces Refinement priority over a toy $8\times 8$ tile grid. Hot colours: high priority (visible, near viewport centre, on a fractal boundary). Grey crosses: off-screen tiles (priority zero). The dashed rectangle is the viewport boundary. Priority concentrates compute budget at the intersection of visibility, focus, and dynamical complexity.}}{106}{figure.0.34}\protected@file@percent }
\newlabel{fig:priority_heatmap}{{34}{106}{Refinement priority over a toy $8\times 8$ tile grid. Hot colours: high priority (visible, near viewport centre, on a fractal boundary). Grey crosses: off-screen tiles (priority zero). The dashed rectangle is the viewport boundary. Priority concentrates compute budget at the intersection of visibility, focus, and dynamical complexity}{figure.0.34}{}}
