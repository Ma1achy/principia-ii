\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Four primitive Pythagorean triples at unit hypotenuse. Mass at each vertex is proportional to the opposite side (Burrau convention). Red arrows: inner Jacobi vector $\bm  {\rho }_1$. Blue arrows: outer Jacobi vector $\bm  {\rho }_2$. Different $\nu =n/m$ values produce genuinely distinct triangle shapes with different Jacobi geometry.}}{29}{figure.0.11}\protected@file@percent }
\newlabel{fig:burrau_triangles}{{11}{29}{Four primitive Pythagorean triples at unit hypotenuse. Mass at each vertex is proportional to the opposite side (Burrau convention). Red arrows: inner Jacobi vector $\boldsymbol \rho _1$. Blue arrows: outer Jacobi vector $\boldsymbol \rho _2$. Different $\nu =n/m$ values produce genuinely distinct triangle shapes with different Jacobi geometry}{figure.0.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The mass simplex $\Delta _2$. The Burrau point for the $(3,4,5)$ triple and the equal-mass barycentre $(\genfrac  {}{}{}1{1}{3},\genfrac  {}{}{}1{1}{3},\genfrac  {}{}{}1{1}{3})$ are marked. The dashed inner triangle shows the $\varepsilon _m$ buffer that keeps masses bounded away from zero. Edge labels indicate which mass vanishes along each boundary.}}{30}{figure.0.12}\protected@file@percent }
